GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_VERTEX_API_VERSION=
STORE_API_BASE_URL=
STORE_API_KEY=
PRODUCT_API_BASE_URL=https://api.mtg.cardnoble.cloud
PRODUCT_API_SEARCH_PATH=/cards/search
PRODUCT_API_LIMIT=24
PRODUCT_API_MAX_VISIBLE_RESULTS=6
PRODUCT_API_MAX_SEARCH_CANDIDATES=5
PRODUCT_API_MAX_RETRIES=2
PRODUCT_API_RETRY_DELAY_MS=500ms
PRODUCT_API_TIMEOUT=10s
MOX_API_BASE_URL=
MOX_API_USERNAME=
MOX_API_PASSWORD=
MOX_API_USER_TYPE=
MOX_API_TIMEOUT=30

STORE_API_BASE_URL=
STORE_API_KEY=
API_PORT=3000

# ─── Google Cloud / Vertex AI (for RAG embeddings) ───────────────────────────
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# ── RAG (self-contained, no external service required) ──────────────────────────
# Folder containing .md knowledge files (buylist.md, policies.md, faq.md, etc.)
RAG_SOURCE_PATH=./rag
# Where the local vector index is stored (created automatically on startup)
RAG_INDEX_PATH=./rag/.vector-index
# Max knowledge chunks returned per query
RAG_MAX_RESULTS=3
RAG_SIMILARITY_THRESHOLD=0.40
# Embedding model (text-embedding-004 = 768-dim, Vertex AI model)
RAG_EMBEDDING_MODEL=text-embedding-004
# Text chunking tuning (word counts)
RAG_CHUNK_SIZE=400
RAG_CHUNK_OVERLAP=50

# ── Optional feature flags ───────────────────────────────────────────────────────
RULES_GROUNDING_ENABLED=false

RAG_CRAWL_ENABLED=true
RAG_DAILY_CRAWL_ENABLED=true

